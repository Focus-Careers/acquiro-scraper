# ── Bubble ────────────────────────────────────────────────────────────────────
BUBBLE_API_KEY=

# ── AI Gateway ────────────────────────────────────────────────────────────────
# Model traffic goes through Vercel AI Gateway (src/utils/ai.js). Only the key is required; model
# names default there and carry a provider prefix ("openai/...") the gateway routes on.
# Never change MODEL_EMBED without rebuilding the Pinecone index — stored vectors depend on it.
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# MODEL_FAST=openai/gpt-6-luna
# MODEL_EMBED=openai/text-embedding-3-small

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# ── SendGrid ──────────────────────────────────────────────────────────────────
# Used to send outreach emails from agent addresses (@acquiro-agent.com)
SENDGRID_API_KEY=
# Override all outgoing Langcliffe emails to this address during testing (remove for production)
LANGCLIFFE_TEST_RECIPIENT=

# ── Zapier ────────────────────────────────────────────────────────────────────
# Webhook URL for sending daily email notifications
ZAPIER_WEBHOOK_URL=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Required to use /admin/* endpoints. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# ── Scheduler (optional) ──────────────────────────────────────────────────────
# Cron expression for daily pipeline (default: 2am London time)
SCRAPE_CRON=0 2 * * *
# Pages to scrape per source in the daily pipeline (default: 20)
SCRAPE_PAGES=20

# ── Server (optional) ─────────────────────────────────────────────────────────
# Railway sets PORT automatically — do not override in production
# PORT=3000
